      "name": "Happy Scenarios",
      "item": [
        {
          "name": "create-item",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "\r",
                  "let part1 = Math.floor(100 + Math.random() * 900).toString();      // 3 digits\r",
                  "let part2 = Math.floor(Math.random() * 10).toString();             // 1 digit\r",
                  "let part3 = Math.floor(10 + Math.random() * 90).toString();        // 2 digits\r",
                  "let part4 = Math.floor(100000 + Math.random() * 900000).toString();// 6 digits\r",
                  "\r",
                  "\r",
                  "let first12 = part1 + part2 + part3 + part4;\r",
                  "\r",
                  "let sum = 0;\r",
                  "\r",
                  "for (let i = 0; i < 12; i++) {\r",
                  "    let digit = parseInt(first12[i]);\r",
                  "\r",
                  "    if (i % 2 === 0) {\r",
                  "        sum += digit * 1;\r",
                  "    } else {\r",
                  "        sum += digit * 3;\r",
                  "    }\r",
                  "}\r",
                  "\r",
                  "let checkDigit = (10 - (sum % 10)) % 10;\r",
                  "\r",
                  "let isbn13 =\r",
                  "    part1 + \"-\" +\r",
                  "    part2 + \"-\" +\r",
                  "    part3 + \"-\" +\r",
                  "    part4 + \"-\" +\r",
                  "    checkDigit;\r",
                  "\r",
                  "pm.environment.set(\"isbn13\", isbn13);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();\r",
                  "pm.environment.set(\"itemId\", response.id);\r",
                  "pm.test(\"Check Satus 201\", function () { \r",
                  "    pm.expect(pm.response.code).to.eql(201);}); \r",
                  "\r",
                  "pm.test(\"Check response message\", function () { \r",
                  "    pm.expect(pm.response.message).to.eql(\"Created\");\r",
                  "}); "
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"type\": \"book\",\n    \"isbn13\": \"{{isbn13}}\",\n    \"price\": 2,\n    \"numberinstock\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
